{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-vs2022-x64",
      "displayName": "CI Visual Studio 2022 x64",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/build/ci-vs2022-x64"
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "package-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "targets": ["package"]
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "ci-package-release",
      "configurePreset": "ci-vs2022-x64",
      "configuration": "Release",
      "targets": ["package"]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-vs2022-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
